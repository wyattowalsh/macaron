{
  "project_name": {
    "__prompt__": "Enter the user-facing name of the project",
    "__default__": "My Awesome Project"
  },
  "project_slug": {
    "__prompt__": "Enter the repository/PyPI-friendly name (lowercase, underscores/hyphens)",
    "__default__": "{{ cookiecutter.project_name.lower().replace(' ', '_').replace('-', '_') or 'python_project' }}"
  },
  "__package_name": "{{ cookiecutter.project_slug.replace('-', '_') }}",
  "project_version": {
    "__prompt__": "Initial project version",
    "__default__": "0.1.0"
  },
  "project_description": {
    "__prompt__": "Short description of the project",
    "__default__": "A modern Python project with React/Tailwind."
  },
  "project_repository": {
    "__prompt__": "Project repository URL (e.g., GitHub)",
    "__default__": "https://github.com/{{ cookiecutter.github }}/{{ cookiecutter.project_slug }}"
  },
  "project_url": {
    "__prompt__": "Project homepage URL (optional)",
    "__default__": ""
  },
  "project_keywords": {
    "__prompt__": "Comma-separated list of keywords for PyPI",
    "__default__": "python, react, tailwind, fastapi, template"
  },

  "full_name": {
    "__prompt__": "Author's full name",
    "__default__": "Wyatt Walsh"
  },
  "email": {
    "__prompt__": "Author's email address",
    "__default__": "wyattowalsh@gmail.com"
  },
  "github": {
    "__prompt__": "Author's GitHub username",
    "__default__": "wyattowalsh"
  },

  "python_version": {
    "__prompt__": "Select the target Python version",
    "__default__": ["3.13", "3.12", "3.11", "3.10", "3.9", "3.8"]
  },
  "package_manager": {
    "__prompt__": "Select the Python package manager",
    "__default__": ["uv", "poetry", "pip", "pipenv", "conda"]
  },
  "use_src_layout": {
    "__prompt__": "Use src/ layout for package structure?",
    "__default__": true
  },

  "add_to_existing": {
    "__prompt__": "Integrate with an existing project structure? (Requires src layout)",
    "__default__": false
  },
  "include_ci_workflow": {
    "__prompt__": "Include GitHub Actions workflow for CI (linting, testing)?",
    "__default__": true
  },
  "include_release_workflow": {
    "__prompt__": "Include GitHub Actions workflow for releasing to PyPI?",
    "__default__": true
  },
  "include_docs_site": {
    "__prompt__": "Include documentation site structure (e.g., Fumadocs)?",
    "__default__": true
  },
  "docs_template": {
    "__prompt__": "Select documentation site template",
    "__default__": ["saas-app-starter", "basic"]
  },
  "include_cli_example": {
    "__prompt__": "Include a basic CLI example using Typer?",
    "__default__": true
  },
  "include_docker": {
    "__prompt__": "Include Dockerfile and docker-compose.yml for containerization?",
    "__default__": true
  },
  "include_frontend": {
    "__prompt__": "Include a React/Tailwind/shadcn frontend setup?",
    "__default__": true
  },
  "frontend_directory": {
    "__prompt__": "Directory name for the frontend application",
    "__default__": "web"
  },
  "include_api": {
    "__prompt__": "Include FastAPI/API development setup?",
    "__default__": false
  },
  "include_database": {
    "__prompt__": "Include database setup (SQLAlchemy/Alembic)?",
    "__default__": false
  },
  "database_type": {
    "__prompt__": "Select database type (if database is included)",
    "__default__": ["postgresql", "sqlite", "mysql", "mongodb"]
  },
  "include_async": {
    "__prompt__": "Include async/await support and libraries?",
    "__default__": false
  },
  "include_monitoring": {
    "__prompt__": "Include monitoring and observability tools?",
    "__default__": false
  },
  "include_security": {
    "__prompt__": "Include security analysis tools (bandit, safety)?",
    "__default__": true
  },
  "include_performance": {
    "__prompt__": "Include performance testing tools?",
    "__default__": false
  },
  "include_notebooks": {
    "__prompt__": "Include support and directory for Jupyter notebooks?",
    "__default__": false
  },
  "include_examples": {
    "__prompt__": "Include an examples/ directory for usage examples?",
    "__default__": false
  },
  "include_benchmarks": {
    "__prompt__": "Include a benchmarks/ directory for performance tests?",
    "__default__": false
  },
  "include_scripts": {
    "__prompt__": "Include a scripts/ directory for utility scripts?",
    "__default__": true
  },
  "include_data": {
    "__prompt__": "Include a data/ directory for data files?",
    "__default__": false
  },

  "include_pre_commit": {
    "__prompt__": "Include pre-commit configuration for Git hooks?",
    "__default__": true
  },
  "include_commitizen": {
    "__prompt__": "Include Commitizen for conventional commits?",
    "__default__": true
  },
  "include_semantic_release": {
    "__prompt__": "Include semantic release automation?",
    "__default__": false
  },
  "include_dependabot": {
    "__prompt__": "Include Dependabot for dependency updates?",
    "__default__": true
  },
  "include_codecov": {
    "__prompt__": "Include Codecov for coverage reporting?",
    "__default__": false
  },
  "include_sonarcloud": {
    "__prompt__": "Include SonarCloud for code quality analysis?",
    "__default__": false
  },
  "include_renovate": {
    "__prompt__": "Include Renovate for dependency management?",
    "__default__": false
  },
  "include_tox": {
    "__prompt__": "Include tox configuration for testing across environments?",
    "__default__": false
  },
  "code_style": {
    "__prompt__": "Select the code formatter (or none to disable)",
    "__default__": ["ruff-format", "black", "yapf", "autopep8", "none"]
  },
  "linter": {
    "__prompt__": "Select the primary linter",
    "__default__": ["ruff", "pylint", "flake8", "none"]
  },
  "type_checker": {
    "__prompt__": "Select the static type checker (or none to disable)",
    "__default__": ["mypy", "pyright", "pyre", "none"]
  },
  "import_sorter": {
    "__prompt__": "Select the import sorter",
    "__default__": ["ruff", "isort", "none"]
  },

  "license_type": {
    "__prompt__": "Select the project license",
    "__default__": [
      "MIT License (MIT)",
      "GNU Affero General Public License v3.0 (AGPL-3.0)",
      "GNU General Public License v3.0 (GPL-3.0)",
      "GNU Lesser General Public License v3.0 (LGPL-3.0)",
      "Mozilla Public License 2.0 (MPL-2.0)",
      "Apache License 2.0 (Apache-2.0)",
      "Boost Software License 1.0 (BSL-1.0)",
      "The Unlicense",
      "Not open source"
    ]
  },
  "include_license_file": {
    "__prompt__": "Generate the LICENSE file based on selection?",
    "__default__": true
  },

  "_extensions": ["cutout.Stencil"],
  "_copy_without_render": [
    "*.html",
    "*.js",
    "*.css",
    "*.png",
    "*.jpg",
    "*.svg",
    "*.ico"
  ],
  "_new_lines": "\n",
  "_output_dir": "."
}