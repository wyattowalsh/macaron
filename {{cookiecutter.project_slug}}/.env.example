# Environment Variables for {{ cookiecutter.project_name }}
# Copy this file to .env and customize as needed

# Application Configuration
{{ cookiecutter.__package_name.upper() }}_ENVIRONMENT=development
{{ cookiecutter.__package_name.upper() }}_DEBUG=true
{{ cookiecutter.__package_name.upper() }}_LOG_LEVEL=DEBUG

{% if cookiecutter.include_api %}
# API Configuration
{{ cookiecutter.__package_name.upper() }}_API_HOST=localhost
{{ cookiecutter.__package_name.upper() }}_API_PORT=8000
{{ cookiecutter.__package_name.upper() }}_API_WORKERS=1
{{ cookiecutter.__package_name.upper() }}_API_RELOAD=true
{% endif %}

{% if cookiecutter.include_database %}
# Database Configuration
{{ cookiecutter.__package_name.upper() }}_DATABASE_URL=sqlite:///./{{ cookiecutter.project_slug }}_dev.db
{{ cookiecutter.__package_name.upper() }}_DATABASE_ECHO=true
{% endif %}

# Performance Configuration
{{ cookiecutter.__package_name.upper() }}_MAX_WORKERS=4
{{ cookiecutter.__package_name.upper() }}_TIMEOUT=30.0

# Development Tools
PYTHONPATH={% if cookiecutter.use_src_layout %}src{% else %}.{% endif %}

# Optional: External Services
# REDIS_URL=redis://localhost:6379/0
# MONGODB_URL=mongodb://localhost:27017/{{ cookiecutter.project_slug }}
# POSTGRES_URL=postgresql://user:password@localhost:5432/{{ cookiecutter.project_slug }}

# Optional: Monitoring and Observability
# SENTRY_DSN=https://your-sentry-dsn
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# Optional: Security
# SECRET_KEY=your-secret-key-here
# JWT_SECRET=your-jwt-secret-here

# Optional: Feature Flags
# FEATURE_NEW_UI=true
# FEATURE_BETA_API=false